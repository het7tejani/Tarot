{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "thetarotcompany.vercel.app"
        }
      ],
      "destination": "https://thepsychicstudio.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.thepsychicstudio.com"
        }
      ],
      "destination": "https://thepsychicstudio.com/:path",
      "permanent": true
    },
    {
      "source": "/readings",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/zodiac-signs",
      "destination": "/zodiac",
      "permanent": true
    },
    {
      "source": "/compatibility",
      "destination": "/zodiac-compatibility",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/cms",
      "destination": "/cms/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/tarot-optimized/:p*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/tarot/:p*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/blog-images/:p*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/reading-images/:p*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/:p*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}