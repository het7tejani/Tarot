{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.thepsychicstudio.com" }],
      "destination": "https://thepsychicstudio.com/:path",
      "permanent": true
    },
    { "source": "/readings", "destination": "/shop", "permanent": true }
  ],
  "rewrites": [
    { "source": "/cms", "destination": "/cms/index.html" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
