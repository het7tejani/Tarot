{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "thetarotcompany.vercel.app"
        }
      ],
      "destination": "https://thepsychicstudio.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.thepsychicstudio.com"
        }
      ],
      "destination": "https://thepsychicstudio.com/:path",
      "permanent": true
    },
    {
      "source": "/readings",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/zodiac-signs",
      "destination": "/zodiac",
      "permanent": true
    },
    {
      "source": "/compatibility",
      "destination": "/zodiac-compatibility",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/cms",
      "destination": "/cms/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}